{
  "name": "pikvm-privacy-mcp-server",
  "version": "0.2.0",
  "description": "Privacy-oriented MCP server for controlling remote machines via PiKVM, with automatic screenshot redaction",
  "main": "dist/index.js",
  "bin": {
    "pikvm-privacy": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup:redactor": "node scripts/setup-redactor.mjs"
  },
  "keywords": [
    "mcp",
    "pikvm",
    "kvm",
    "remote-control",
    "hid",
    "privacy",
    "redaction",
    "pii"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.2.3",
    "sharp": "^0.33.0",
    "undici": "^7.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
