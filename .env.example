# pikvm-privacy MCP Server Configuration

# Required: PiKVM host URL
PIKVM_HOST=https://<your-pikvm-ip>

# Required: PiKVM password
PIKVM_PASSWORD=your_password

# Optional: PiKVM username (default: admin)
PIKVM_USERNAME=admin

# Optional: Verify SSL certificates (default: false for self-signed certs)
PIKVM_VERIFY_SSL=false

# Optional: Default keyboard layout (default: en-us)
PIKVM_DEFAULT_KEYMAP=en-us

# Optional: Auto-calibration settings
# Number of sampling rounds for auto-calibration (default: 5)
PIKVM_CALIBRATION_ROUNDS=5
# Number of verification rounds after computing calibration (default: 5)
PIKVM_CALIBRATION_VERIFY_ROUNDS=5
# Delay in ms after each mouse move during calibration (default: 300, increase for slow connections)
PIKVM_CALIBRATION_MOVE_DELAY=300

# Optional: Screenshot redaction settings
# Python interpreter for the redactor (default: .venv-redactor created by `npm run setup:redactor`)
# PIKVM_REDACTOR_PYTHON=/path/to/python
# Comma-separated categories to redact (default: all)
# PIKVM_REDACTOR_CATEGORIES=secrets,contact,financial,government_id,network,person,location,dates,faces,codes
# Redaction style: black box, pixelate or blur (default: black box)
PIKVM_REDACTOR_STYLE=black box
# Use the GLiNER model for names/addresses/dates of birth (default: true; if true, load fails when the model is unavailable)
PIKVM_REDACTOR_USE_NER=true
# Timeouts in ms for loading the models and for each redaction (defaults: 180000, 60000)
PIKVM_REDACTOR_LOAD_TIMEOUT_MS=180000
PIKVM_REDACTOR_TIMEOUT_MS=60000
